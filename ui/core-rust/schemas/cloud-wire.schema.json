{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org.aerobag.ui-wire.cloud",
  "title": "UiCloudPageState",
  "description": "Core-owned Cloud UI and provider-effect wire contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "sync_account_heading",
    "provider_heading",
    "overall_status_label",
    "sync_account_panels",
    "overall_status",
    "next_refresh_epoch_ms"
  ],
  "properties": {
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "sync_account_heading": { "type": "string" },
    "provider_heading": { "type": "string" },
    "overall_status_label": { "type": "string" },
    "sync_account_panels": {
      "type": "array",
      "items": { "$ref": "#/$defs/UiCloudPanel" }
    },
    "provider_card": { "$ref": "#/$defs/UiCloudPanel" },
    "overall_status": { "$ref": "#/$defs/UiCloudPanel" },
    "next_refresh_epoch_ms": {
      "type": ["integer", "null"],
      "format": "int64",
      "default": null
    }
  },
  "x-export-order": [
    "CloudProviderKind",
    "CloudProviderPrincipal",
    "CloudAuthorizationMode",
    "CloudAuthorizationRequest",
    "CloudAuthorizationResponse",
    "CloudUiActionId",
    "CloudUiFieldId",
    "CloudUiFieldValue",
    "UiQrCode",
    "CloudPlatformEffect",
    "UiCloudPanelState",
    "UiCloudAction",
    "UiCloudPanelControl",
    "UiCloudTimeFact",
    "UiCloudPanel",
    "UiCloudPageState",
    "CloudHttpMethod",
    "CloudHttpHeader",
    "CloudHttpRequest",
    "CloudHttpResponse"
  ],
  "$defs": {
    "CloudProviderKind": {
      "type": "string",
      "enum": ["google_drive", "aerobag_cloud"]
    },
    "CloudProviderPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id", "display_label"],
      "properties": {
        "stable_id": { "type": "string" },
        "display_label": { "type": "string" }
      }
    },
    "CloudAuthorizationMode": {
      "type": "string",
      "enum": ["silent", "interactive"]
    },
    "CloudAuthorizationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "provider", "mode", "scopes"],
      "properties": {
        "request_id": { "type": "integer", "format": "int64" },
        "provider": { "$ref": "#/$defs/CloudProviderKind" },
        "mode": { "$ref": "#/$defs/CloudAuthorizationMode" },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "CloudAuthorizationResponse": {
      "x-discriminator": "state",
      "oneOf": [
        {
          "title": "Authorized",
          "type": "object",
          "required": ["state", "expires_at_epoch_ms", "principal"],
          "properties": {
            "state": { "const": "authorized" },
            "expires_at_epoch_ms": { "type": ["integer", "null"], "format": "int64" },
            "principal": { "$ref": "#/$defs/CloudProviderPrincipal" }
          }
        },
        {
          "title": "InteractionRequired",
          "type": "object",
          "required": ["state", "diagnostic"],
          "properties": {
            "state": { "const": "interaction_required" },
            "diagnostic": { "type": ["string", "null"] }
          }
        },
        {
          "title": "Denied",
          "type": "object",
          "required": ["state", "diagnostic"],
          "properties": {
            "state": { "const": "denied" },
            "diagnostic": { "type": ["string", "null"] }
          }
        },
        {
          "title": "TransientFailure",
          "type": "object",
          "required": ["state", "diagnostic"],
          "properties": {
            "state": { "const": "transient_failure" },
            "diagnostic": { "type": ["string", "null"] }
          }
        },
        {
          "title": "PermanentFailure",
          "type": "object",
          "required": ["state", "diagnostic"],
          "properties": {
            "state": { "const": "permanent_failure" },
            "diagnostic": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "CloudUiActionId": {
      "type": "string",
      "enum": [
        "begin_setup",
        "begin_create",
        "back_setup",
        "select_provider_google_drive",
        "select_provider_aerobag_cloud",
        "scan_setup_code",
        "accept_setup_code",
        "authorize_provider",
        "create_account",
        "backup_setup_code",
        "add_device",
        "close_linked_detail",
        "begin_unlink",
        "confirm_unlink",
        "sync_now",
        "copy_setup_code"
      ]
    },
    "CloudUiFieldId": {
      "type": "string",
      "enum": ["device_setup_code"]
    },
    "CloudUiFieldValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/CloudUiFieldId" },
        "value": { "type": "string" }
      }
    },
    "UiQrCode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "quiet_zone_modules", "accessibility_label"],
      "properties": {
        "rows": {
          "type": "array",
          "items": { "type": "string" }
        },
        "quiet_zone_modules": { "type": "integer", "format": "int32" },
        "accessibility_label": { "type": "string" }
      }
    },
    "CloudPlatformEffect": {
      "x-discriminator": "kind",
      "oneOf": [
        {
          "title": "BeginAuthorization",
          "type": "object",
          "required": ["kind", "provider", "scopes"],
          "properties": {
            "kind": { "const": "begin_authorization" },
            "provider": { "$ref": "#/$defs/CloudProviderKind" },
            "scopes": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "title": "ScanQrCode",
          "type": "object",
          "required": ["kind", "completion_action", "field_id"],
          "properties": {
            "kind": { "const": "scan_qr_code" },
            "completion_action": { "$ref": "#/$defs/CloudUiActionId" },
            "field_id": { "$ref": "#/$defs/CloudUiFieldId" }
          }
        },
        {
          "title": "CopyText",
          "type": "object",
          "required": ["kind", "text", "completion_label"],
          "properties": {
            "kind": { "const": "copy_text" },
            "text": { "type": "string" },
            "completion_label": { "type": "string" }
          }
        }
      ]
    },
    "UiCloudPanelState": {
      "type": "string",
      "enum": ["complete", "active", "working", "informational", "caution", "error"]
    },
    "UiCloudAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "enabled", "required_fields"],
      "properties": {
        "id": { "$ref": "#/$defs/CloudUiActionId" },
        "label": { "type": "string" },
        "enabled": { "type": "boolean" },
        "disabled_reason": { "type": ["string", "null"], "default": null },
        "required_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/CloudUiFieldId" },
          "default": []
        },
        "platform_effect": { "$ref": "#/$defs/CloudPlatformEffect" }
      }
    },
    "UiCloudPanelControl": {
      "x-discriminator": "kind",
      "oneOf": [
        {
          "title": "DeviceSetupCodeInput",
          "type": "object",
          "required": ["kind", "field_id", "label", "placeholder"],
          "properties": {
            "kind": { "const": "device_setup_code_input" },
            "field_id": { "$ref": "#/$defs/CloudUiFieldId" },
            "label": { "type": "string" },
            "placeholder": { "type": "string" }
          }
        },
        {
          "title": "DeviceSetupCodeOutput",
          "type": "object",
          "required": ["kind", "setup_code", "qr_code", "copy_action"],
          "properties": {
            "kind": { "const": "device_setup_code_output" },
            "setup_code": { "type": "string" },
            "qr_code": { "$ref": "#/$defs/UiQrCode" },
            "copy_action": { "$ref": "#/$defs/UiCloudAction" }
          }
        }
      ]
    },
    "UiCloudPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state", "time_facts", "actions"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "state": { "$ref": "#/$defs/UiCloudPanelState" },
        "state_label": { "type": ["string", "null"], "default": null },
        "summary": { "type": ["string", "null"], "default": null },
        "time_facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/UiCloudTimeFact" },
          "default": []
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/UiCloudAction" },
          "default": []
        },
        "control": { "$ref": "#/$defs/UiCloudPanelControl" }
      }
    },
    "UiCloudTimeFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "epoch_ms"],
      "properties": {
        "label": { "type": "string" },
        "epoch_ms": { "type": "integer", "format": "int64" }
      }
    },
    "CloudHttpMethod": {
      "type": "string",
      "enum": ["get", "post", "delete"]
    },
    "CloudHttpHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "CloudHttpRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "provider", "method", "url", "headers", "body_base64", "max_response_bytes"],
      "properties": {
        "request_id": { "type": "integer", "format": "int64" },
        "provider": { "$ref": "#/$defs/CloudProviderKind" },
        "method": { "$ref": "#/$defs/CloudHttpMethod" },
        "url": { "type": "string" },
        "headers": {
          "type": "array",
          "items": { "$ref": "#/$defs/CloudHttpHeader" }
        },
        "body_base64": { "type": ["string", "null"] },
        "max_response_bytes": { "type": "integer", "format": "int64" }
      }
    },
    "CloudHttpResponse": {
      "x-discriminator": "result",
      "oneOf": [
        {
          "title": "Completed",
          "type": "object",
          "required": ["result", "status_code", "body_base64"],
          "properties": {
            "result": { "const": "completed" },
            "status_code": { "type": "integer" },
            "body_base64": { "type": "string" }
          }
        },
        {
          "title": "TransportError",
          "type": "object",
          "required": ["result", "detail"],
          "properties": {
            "result": { "const": "transport_error" },
            "detail": { "type": "string" }
          }
        },
        {
          "title": "ResponseTooLarge",
          "type": "object",
          "required": ["result", "limit_bytes"],
          "properties": {
            "result": { "const": "response_too_large" },
            "limit_bytes": { "type": "integer", "format": "int64" }
          }
        }
      ]
    }
  }
}
