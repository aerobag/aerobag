{
  "$defs": {
    "NexradOverlayAnimation": {
      "additionalProperties": false,
      "properties": {
        "age_labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "age_summary": {
          "type": "string"
        },
        "frame_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "next_update_delay_ms": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "next_update_epoch_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/$defs/NexradOverlayAnimationPhase"
        },
        "selected_frame_index": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "phase",
        "frame_count",
        "age_labels",
        "age_summary"
      ],
      "type": "object"
    },
    "NexradOverlayAnimationPhase": {
      "enum": [
        "idle",
        "frame",
        "blank"
      ],
      "type": "string"
    },
    "NexradOverlayScreenPoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "NexradOverlayStats": {
      "additionalProperties": false,
      "properties": {
        "level_pixel_span_px": {
          "format": "double",
          "type": "number"
        },
        "max_affine_error_px": {
          "format": "double",
          "type": "number"
        },
        "max_level_pixel_stretch_px": {
          "format": "double",
          "type": "number"
        },
        "max_stack_depth": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "observed_at_utc": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "render_piece_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "res": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source_tile_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "split_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "source_tile_count",
        "render_piece_count",
        "split_count",
        "max_affine_error_px",
        "level_pixel_span_px",
        "max_level_pixel_stretch_px",
        "max_stack_depth"
      ],
      "type": "object"
    },
    "NexradOverlayStatus": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "hidden",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "loading",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "count": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "const": "ready",
              "type": "string"
            }
          },
          "required": [
            "state",
            "count"
          ],
          "type": "object"
        }
      ],
      "x-discriminator": "state"
    },
    "NexradOverlayTile": {
      "additionalProperties": false,
      "properties": {
        "corners": {
          "$ref": "#/$defs/NexradOverlayTileCorners"
        },
        "image_height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "image_width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "res": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_x": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_y": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "src": {
          "type": "string"
        },
        "x": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "src",
        "res",
        "x",
        "y",
        "source_x",
        "source_y",
        "source_width",
        "source_height",
        "image_width",
        "image_height",
        "corners"
      ],
      "type": "object"
    },
    "NexradOverlayTileCorners": {
      "additionalProperties": false,
      "properties": {
        "ne": {
          "$ref": "#/$defs/NexradOverlayScreenPoint"
        },
        "nw": {
          "$ref": "#/$defs/NexradOverlayScreenPoint"
        },
        "se": {
          "$ref": "#/$defs/NexradOverlayScreenPoint"
        },
        "sw": {
          "$ref": "#/$defs/NexradOverlayScreenPoint"
        }
      },
      "required": [
        "nw",
        "ne",
        "se",
        "sw"
      ],
      "type": "object"
    }
  },
  "$id": "org.aerobag.ui-wire.nexrad-overlay",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Core-owned wire contract for NEXRAD overlay queries emitted by app-core.",
  "properties": {
    "animation": {
      "$ref": "#/$defs/NexradOverlayAnimation"
    },
    "stats": {
      "$ref": "#/$defs/NexradOverlayStats"
    },
    "status": {
      "$ref": "#/$defs/NexradOverlayStatus"
    },
    "tiles": {
      "items": {
        "$ref": "#/$defs/NexradOverlayTile"
      },
      "type": "array"
    }
  },
  "required": [
    "status",
    "tiles",
    "stats",
    "animation"
  ],
  "title": "NexradOverlayQueryResult",
  "type": "object",
  "x-contract-version": 3,
  "x-export-order": [
    "NexradOverlayStatus",
    "NexradOverlayAnimationPhase",
    "NexradOverlayAnimation",
    "NexradOverlayScreenPoint",
    "NexradOverlayTileCorners",
    "NexradOverlayTile",
    "NexradOverlayStats",
    "NexradOverlayQueryResult"
  ]
}
