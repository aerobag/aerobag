+def _store_cached_bytes(url, data, name=None):
+    blobs, _ = _cache_dirs()
+    if blobs is None:
+        return
+    sha256 = hashlib.sha256(data).hexdigest()
+    blob_path = os.path.join(blobs, sha256)
+    if not os.path.isfile(blob_path):
+        with open(blob_path, "wb") as dst:
+            dst.write(data)
+    metadata = {
+        "sha256": sha256,
+        "size": len(data),
+        "url": url,
+    }
+    if name is not None:
+        metadata["file"] = name
+    metadata_path = _cache_metadata_path(url)
+    with open(metadata_path, "w", encoding="utf-8") as handle:
+        json.dump(metadata, handle, sort_keys=True)
