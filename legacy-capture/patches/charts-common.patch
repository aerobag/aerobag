+CAPTURE_META_DIR = os.environ.get("CAPTURE_META_DIR")
+CAPTURE_LABEL = os.environ.get("CAPTURE_LABEL", "")
+FETCH_CACHE_ROOT = os.environ.get("FETCH_CACHE_ROOT")
+FETCH_CACHE_MODE = os.environ.get("FETCH_CACHE_MODE", "fill").lower()
+
+
+def _capture_path(name):
+    if not CAPTURE_META_DIR:
+        return None
+    os.makedirs(CAPTURE_META_DIR, exist_ok=True)
+    return os.path.join(CAPTURE_META_DIR, name)
+
+
+def _sha256(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _record_jsonl(name, payload):
+    path = _capture_path(name)
+    if path is None:
+        return
+    with open(path, "a", encoding="utf-8") as handle:
+        handle.write(json.dumps(payload, sort_keys=True) + "\n")
+
+
+def _cache_dirs():
+    if not FETCH_CACHE_ROOT:
+        return None, None
+    blobs = os.path.join(FETCH_CACHE_ROOT, "blobs")
+    http = os.path.join(FETCH_CACHE_ROOT, "http")
+    os.makedirs(blobs, exist_ok=True)
+    os.makedirs(http, exist_ok=True)
+    return blobs, http
+
+
+def _cache_metadata_path(url):
+    _, http = _cache_dirs()
+    if http is None:
+        return None
+    return os.path.join(http, hashlib.sha256(url.encode("utf-8")).hexdigest() + ".json")
+
+
+def _load_cached_download(url):
+    metadata_path = _cache_metadata_path(url)
+    if metadata_path is None or not os.path.isfile(metadata_path):
+        return None
+    with open(metadata_path, "r", encoding="utf-8") as handle:
+        metadata = json.load(handle)
+    blob_path = os.path.join(FETCH_CACHE_ROOT, "blobs", metadata["sha256"])
+    if not os.path.isfile(blob_path):
+        return None
+    return metadata, blob_path
+
+
+def _store_cached_download(url, name):
+    blobs, _ = _cache_dirs()
+    if blobs is None:
+        return
+    sha256 = _sha256(name)
+    blob_path = os.path.join(blobs, sha256)
+    if not os.path.isfile(blob_path):
+        with open(name, "rb") as src, open(blob_path, "wb") as dst:
+            dst.write(src.read())
+    metadata_path = _cache_metadata_path(url)
+    with open(metadata_path, "w", encoding="utf-8") as handle:
+        json.dump({
+            "file": name,
+            "sha256": sha256,
+            "size": os.path.getsize(name),
+            "url": url,
+        }, handle, sort_keys=True)
+
+
