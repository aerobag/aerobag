set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ARTIFACT_ROOT="${AEROBAG_ARTIFACT_ROOT:-/root/aerobag-artifacts}"
STATE_ROOT="${AEROBAG_NMS_STATE_ROOT:-$ARTIFACT_ROOT/dev-stack/state/nms-notams}"
CURRENT_ARTIFACTS="${AEROBAG_CURRENT_ARTIFACTS:-$ARTIFACT_ROOT/published/current_artifacts.json}"
KEYWORD="IAP"
CYCLE=""
NAV_DB_DIR=""
REPORT="/tmp/aerobag-procedure-rendezvous-audit.json"

usage() {
    cat <<'EOF'
Usage: tools/audit-procedure-rendezvous [options]

Options:
  --keyword IAP|ODP|SID|STAR  Procedure class to audit (default: IAP)
  --all                       Audit every procedure class
  --cycle YYCC                Use this published cycle instead of today's cycle
  --nav-db DIR                Use an explicit unpacked nav_db directory
  --state-root DIR            Use an explicit NMS collector state root
  --report PATH               Write the full JSON report here
  -h, --help                  Show this help
EOF
}

while (($#)); do
    case "$1" in
        --keyword)
            KEYWORD="${2:?--keyword requires a value}"
            shift 2
            ;;
        --all)
            KEYWORD=""
            shift
            ;;
        --cycle)
            CYCLE="${2:?--cycle requires a value}"
            shift 2
            ;;
        --nav-db)
            NAV_DB_DIR="${2:?--nav-db requires a path}"
            shift 2
            ;;
        --state-root)
            STATE_ROOT="${2:?--state-root requires a path}"
            shift 2
            ;;
        --report)
            REPORT="${2:?--report requires a path}"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [[ -z "$NAV_DB_DIR" ]]; then
    if [[ -z "$CYCLE" ]]; then
        TODAY="$(date -u +%F)"
        CYCLE="$(jq -er --arg today "$TODAY" 'first(
            .[0].startup_prefetch.cycle_resources[]
            | select(.start_valid <= $today and $today < .end_valid)
            | .cycle
        )' "$CURRENT_ARTIFACTS")"
    fi
    NAV_ROOT_URL="$(jq -er --arg cycle "$CYCLE" 'first(
        .[0].startup_prefetch.cycle_resources[]
        | select(.cycle == $cycle)
        | .resources[].url
        | select(endswith("/root"))
    )' "$CURRENT_ARTIFACTS")"
    NAV_DB_DIR="$ARTIFACT_ROOT/published/${NAV_ROOT_URL%/root}"
fi

COMMAND=(
    cargo run --quiet
    --manifest-path "$REPO_ROOT/product/preprocessor/Cargo.toml"
    --package nms-notams-fetch
    -- audit-rendezvous
    --state-root "$STATE_ROOT"
    --nav-db "$NAV_DB_DIR"
)
if [[ -n "$KEYWORD" ]]; then
    COMMAND+=(--keyword "$KEYWORD")
fi

"${COMMAND[@]}" > "$REPORT"
jq '{
    elapsed_ms,
    procedure_records,
    nav_rendezvous_key_count,
    summaries,
    findings: (.findings | length),
    missing_active_source_versions: (.missing_active_source_versions | length)
}' "$REPORT"
echo "Full report: $REPORT"
