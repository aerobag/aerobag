{
  "name": "avare-web-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:fixture": "./scripts/prepare-fixture.sh",
    "build:wasm": "./scripts/build-wasm.sh",
