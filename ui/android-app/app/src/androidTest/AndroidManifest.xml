<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="org.aerobag.app.permission.READ_E2E_PROJECTIONS" />

    <application>
        <service
            android:name="org.aerobag.app.e2e.SemanticDriverService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/e2e_accessibility_service" />
        </service>
        <service
            android:name="org.aerobag.app.e2e.SemanticDriverInputMethodService"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/e2e_input_method" />
        </service>
    </application>
</manifest>
