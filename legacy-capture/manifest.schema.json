{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerobag.local/schemas/legacy-capture-manifest.schema.json",
  "title": "Legacy Capture Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at_utc",
    "captures"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "image": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "repo",
          "command",
          "stdout_log",
          "stderr_log",
          "outputs_hashes"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "stdout_log": {
            "type": "string"
          },
          "stderr_log": {
            "type": "string"
          },
          "tile_paths": {
            "type": "string"
          },
          "outputs_hashes": {
            "type": "string"
          },
          "source_urls": {
            "type": "string"
          },
          "downloads": {
            "type": "string"
          },
          "package_outputs": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
